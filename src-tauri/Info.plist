<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_xiadianxin._udp</string>
		<string>_omiai._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>下点心 uses local networking to discover nearby peers and find the Omiai signaling server on your LAN.</string>
	<key>NSCameraUsageDescription</key>
	<string>下点心 needs camera access for video calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>下点心 needs microphone access for voice and video calls.</string>
</dict>
</plist>
